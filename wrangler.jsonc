{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adalie-website",
  "account_id": "f5dbfc5cf299cd799bf49f258675f82b",
  "main": "worker.mjs",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "adalie.me/*", "zone_name": "adalie.me" },
    { "pattern": "www.adalie.me/*", "zone_name": "adalie.me" },
    { "pattern": "dacubeking.com/*", "zone_name": "dacubeking.com" },
    { "pattern": "www.dacubeking.com/*", "zone_name": "dacubeking.com" }
  ],
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": { "enabled": true }
}
