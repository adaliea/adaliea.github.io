{
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "*.ts",
      "*.mjs",
      "*.json",
      "!!src/generated",
      "!!package-lock.json",
      "!!next-env.d.ts",
      "!!cloudflare-env.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "css": { "parser": { "tailwindDirectives": true } }
}
